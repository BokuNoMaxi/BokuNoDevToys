{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"paths": {
			"marked": ["./node_modules/marked"],
			"sql-formatter": ["./node_modules/sql-formatter"],
			"bcryptjs": ["./node_modules/bcryptjs"]
		}
	},
	"include": ["src/**/*", "../src/lib/core/**/*"]
}
